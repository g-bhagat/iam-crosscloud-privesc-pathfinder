# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
# .terraform.lock.hcl is intentionally NOT ignored -- commit it for
# reproducible provider version resolution.

# Credentials -- SCOPE.md: no long-lived credentials committed, ever
*.pem
*.key
service-account*.json
*-credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Generated demo/visualization output (regenerate via scripts/run_pipeline_demo.py)
sample_data/*.html
# pyvis's local asset bundle if cdn_resources="in_line" is ever bypassed
/lib/

# OS
.DS_Store
.DS_Store
.DS_Store
